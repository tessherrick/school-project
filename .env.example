# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Anthropic (for hypothesis generator)
ANTHROPIC_API_KEY=sk-ant-...

# Whoop Developer API (https://developer.whoop.com)
# WHOOP_REDIRECT_URI must exactly match a redirect URI registered for your app
# in the Whoop developer console at developer.whoop.com.
WHOOP_CLIENT_ID=...
WHOOP_CLIENT_SECRET=...
WHOOP_REDIRECT_URI=https://your-ngrok-or-production-url/api/auth/whoop/callback

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Frontend URL — used for OAuth redirect after Whoop authorization
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
